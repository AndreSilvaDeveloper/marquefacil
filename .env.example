# Endereço do sistema (o domínio precisa apontar para o IP da VPS)
DOMAIN=agenda.seudominio.com.br

# Deixar qualquer pessoa criar conta de salão? (false = só você cria)
ALLOW_SIGNUP=true

# Site do app antigo, que pode mandar os dados para cá na mudança
HANDOFF_ORIGINS=https://andresilvadeveloper.github.io
