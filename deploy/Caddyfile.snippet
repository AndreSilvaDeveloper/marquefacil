# Bloco para ACRESCENTAR no fim de /var/www/caddy/Caddyfile (não substituir o arquivo:
# ele atende zenfra, vault e dev.workid). O Caddy precisa estar na rede `marquefacil`:
#   docker network connect marquefacil caddy
# Depois:
#   docker exec caddy caddy validate --config /etc/caddy/Caddyfile
#   docker exec caddy caddy reload --config /etc/caddy/Caddyfile
# Só depois que maquefacil.com.br já apontar para 77.37.40.221.

maquefacil.com.br, www.maquefacil.com.br {
	import security_headers
	encode zstd gzip
	reverse_proxy marquefacil-app:3000
}
